{
  "name": "shine-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "build": "tsc --noEmit && node -e \"require('fs-extra').removeSync('dist')\" && npx esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm \"--banner:js=import { createRequire as __esbuild_createRequire } from 'module'; import { fileURLToPath as __esbuild_fileURLToPath } from 'url'; import { dirname as __esbuild_dirname } from 'path'; const require = __esbuild_createRequire(import.meta.url); const __filename = __esbuild_fileURLToPath(import.meta.url); const __dirname = __esbuild_dirname(__filename); if (typeof globalThis.navigator === 'undefined') { globalThis.navigator = { userAgent: 'node' }; } if (typeof navigator === 'undefined') { var navigator = globalThis.navigator; }\" --outfile=dist/index.js --external:playwright --external:playwright-core --external:fluent-ffmpeg --external:ffmpeg-static --external:chromium-bidi* --external:fsevents && node -e \"require('fs-extra').copySync('src/skills', 'dist/skills'); require('fs-extra').copySync('src/prompts', 'dist/prompts')\"",
    "postinstall": "node -e \"const fs=require('fs');if(fs.existsSync('../scripts/patch-renderer.js'))require('child_process').execSync('node ../scripts/patch-renderer.js',{stdio:'inherit'});else if(fs.existsSync('scripts/patch-renderer.js'))require('child_process').execSync('node scripts/patch-renderer.js',{stdio:'inherit'});\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@backblaze-labs/b2-sdk": "^0.2.0",
    "@contentauth/sdk": "^0.8.12",
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/firestore": "^9.0.0",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.16.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@openvideo/video-renderer": "^1.0.0",
    "@openvideo/engine-pixi": "^1.3.2",
    "@peculiar/webcrypto": "^1.7.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mime": "^4.1.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^8.0.0",
    "playwright": "^1.50.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.2",
    "fs-extra": "^11.3.3",
    "javascript-obfuscator": "^5.3.0",
    "nodemon": "^3.1.9",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
