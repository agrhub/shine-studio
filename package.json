{
  "name": "shine",
  "version": "0.0.1",
  "description": "AI Micro-Drama Video Studio, Vue 3 + Element Plus & Express",
  "type": "module",
  "scripts": {
    "server": "pnpm --filter shine-server dev",
    "client": "pnpm --filter shine-client dev",
    "flow-worker": "pnpm --filter shine-flow-worker dev",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "client:build": "pnpm --filter shine-client build",
    "server:build": "pnpm --filter shine-server build",
    "build": "pnpm run client:build && pnpm run server:build",
    "start": "pnpm --filter shine-server start",
    "deploy:cloudrun": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-cloudrun.ps1",
    "deploy:cloudrun:sh": "bash ./scripts/deploy-cloudrun.sh",
    "deploy:app": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-cloudrun.ps1 -SkipWorkers -SkipInfra",
    "deploy:app:sh": "bash ./scripts/deploy-cloudrun.sh --skip-workers --skip-infra",
    "deploy:render-worker": "powershell -ExecutionPolicy Bypass -File ./services/render-worker/deploy.ps1",
    "deploy:demucs-worker": "powershell -ExecutionPolicy Bypass -File ./services/demucs-worker/deploy.ps1",
    "postinstall": "node -e \"const fs=require('fs');if(fs.existsSync('scripts/patch-renderer.js'))require('child_process').execSync('node scripts/patch-renderer.js',{stdio:'inherit'});\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "module-alias": "^2.3.4"
  }
}