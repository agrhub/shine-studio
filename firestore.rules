rules_version = '2';
// The Shine backend talks to Firestore through the server-side SDK with a
// service account, which bypasses these rules. No browser/mobile client is
// allowed to read or write the database directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
