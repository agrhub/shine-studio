# ==============================================================================
# 🎬 Shine AI Micro-Drama Studio — Environment Configuration (.env.example)
# ==============================================================================

# --- 1. Database Configuration ---
DB_PROVIDER="firestore" # "firestore" | "mongodb" | "sqlite" | "mapdb"
FIRESTORE_PROJECT_ID="your-gcp-project-id"
FIRESTORE_DATABASE_ID="shine-db"
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shine?appName=ShineApp"
SQLITE_DB_PATH="server/data/shine.db"
MAPDB_PATH="server/data/mapdb.json"

# --- 2. Google Cloud Run Microservices ---
DEMUCS_SERVICE_URL="https://demucs-worker-xxxx-as.a.run.app"
RENDER_WORKER_URL="https://shine-render-worker-xxxx-as.a.run.app"
FLOW_WORKER_URL="https://flow-worker-xxxx-as.a.run.app"
FLOW_ENABLE_HEADLESS="false"

# --- 3. Cloud Storage Provider (B2 / S3 / GCS / Local) ---
STORAGE_PROVIDER="b2" # "b2" | "s3" | "gcs" | "local"
S3_BUCKET_NAME="shine-studio-media"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_ACCOUNT_ID=""
S3_PUBLIC_DOMAIN=""
S3_REGION="us-east-005"
S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
GCS_BUCKET_NAME="shine-studio-media"
GCS_PUBLIC_DOMAIN=""

# --- 4. Google Cloud Pub/Sub ---
PUBSUB_TOPIC_RENDER="shine-render-jobs"
PUBSUB_TOPIC_STATUS="shine-render-status"
PUBSUB_SUBSCRIPTION_RENDER="shine-render-sub"
PUBSUB_SUBSCRIPTION_STATUS="shine-render-status-sub"

# --- 5. Stock Video, Audio & SFX APIs ---
PEXELS_URL="https://api.pexels.com"
PEXELS_API_KEY="your_pexels_api_key"

PIXABAY_URL="https://pixabay.com/api"
PIXABAY_API_KEY="your_pixabay_api_key"

FREESOUND_URL="https://freesound.org/apiv2/search/text"
FREESOUND_CLIENT_ID="your_freesound_client_id"
FREESOUND_API_KEY="your_freesound_api_key"

# --- 6. Parallel MCP Task Server ---
PARALLEL_API_KEY="your_parallel_api_key"
PARALLEL_URL="https://search.parallel.ai/mcp"

# --- 7. Grafana & Observability ---
GRAFANA_MCP_ENDPOINT="https://mcp.grafana.com/mcp"
GRAFANA_URL="https://your-org.grafana.net"
GRAFANA_API_KEY="your_grafana_api_key"

# --- 8. Google AI & Vertex AI Models ---
GEMINI_MODEL_TEXT="gemini-3.5-flash-lite"
GEMINI_MODEL_IMAGE="gemini-3.1-flash-lite-image"
GEMINI_MODEL_VIDEO="veo-3.1-generate-001"
GEMINI_MODEL_TTS="gemini-3.1-flash-tts-preview"
GEMINI_MODEL_VOICE="gemini-live-2.5-flash-native-audio"
GEMINI_MODEL_MUSIC="lyria-3-clip-preview"
GEMINI_MODEL_AGENT="gemini-3.5-flash-lite"
GEMINI_MODEL_OMNI="gemini-omni-1.1-flash-preview"
GEMINI_MODEL_TRANSCRIBE="gemini-3.5-transcribe-preview"
ANTIGRAVITY_MODEL="gemini-3.7-flash"

GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="1"
GOOGLE_APPLICATION_CREDENTIALS="gcp-service-account.json"

# --- 9. Email SMTP & Notifications ---
SMTP_HOST="mail.your-domain.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="shine@your-domain.com"
SMTP_PASS="your_smtp_password"
SMTP_NAME="Shine"
ADMIN_EMAIL="admin@your-domain.com"

# --- 10. Captcha Solving ---
CAPTCHA_METHOD="capsolver"
CAPTCHA_API_KEY="your_captcha_api_key"
CAPTCHA_BASE_URL="https://api.capsolver.com"

# --- 11. SSO & Social Platform Integration ---
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/sso/callback/google"

YOUTUBE_CLIENT_ID="your_youtube_client_id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"
YOUTUBE_REDIRECT_URI="http://localhost:3001/api/auth/oauth/callback/youtube"

# --- 12. Video Pipeline Settings ---
GENERATE_START_END_FRAME="true"

# --- 13. Cloud Run Resource & Autoscaling Settings (Defaults: 2 CPU / 4Gi RAM, Render Pool: 1-100 instances) ---
# Set to "false" to skip rebuilding workers and speed up main app deployment (saves ~3-5 mins):
DEPLOY_WORKERS="true"
DEPLOY_INFRA="true"
# DEPLOY_DEMUCS="true"
# DEPLOY_RENDER="true"

RENDER_WORKER_CPU="2"
RENDER_WORKER_MEMORY="4Gi"
RENDER_WORKER_TIMEOUT="600"
RENDER_WORKER_MIN_INSTANCES="0"
RENDER_WORKER_MAX_INSTANCES="5"
RENDER_WORKER_CONCURRENCY="10"
RENDER_POOL_SIZE="4"
RENDER_POOL_MIN="1"
RENDER_MAX_PER_INSTANCE="25"

DEMUCS_WORKER_CPU="1"
DEMUCS_WORKER_MEMORY="2Gi"
DEMUCS_WORKER_TIMEOUT="300"
DEMUCS_WORKER_MIN_INSTANCES="0"
DEMUCS_WORKER_MAX_INSTANCES="1"

FLOW_WORKER_CPU="1"
FLOW_WORKER_MEMORY="2Gi"
FLOW_WORKER_TIMEOUT="300"
FLOW_WORKER_MIN_INSTANCES="0"
FLOW_WORKER_MAX_INSTANCES="1"

APP_CPU="2"
APP_MEMORY="4Gi"
APP_TIMEOUT="300"
APP_MIN_INSTANCES="0"
APP_MAX_INSTANCES="3"